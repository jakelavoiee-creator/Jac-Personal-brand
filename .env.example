# Stripe — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Optional: a Price you created in Stripe for THE IDENTITY RESET ($25 one-time).
# If empty, checkout uses an inline $25.00 USD price.
STRIPE_PRICE_ID=

# Long random string used to sign the access cookie. Generate: openssl rand -hex 32
ACCESS_SECRET=

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
