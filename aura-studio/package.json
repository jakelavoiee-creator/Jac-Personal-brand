{
  "name": "aura-studio",
  "version": "0.1.0",
  "description": "Aura Studio — professional design platform (Stage 3: templates, brand kits, smart resize, SVG/PDF)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc",
    "test": "node tests/e2e.mjs && node tests/e2e-tools.mjs && node tests/e2e-stage2.mjs && node tests/e2e-stage3.mjs && node tests/e2e-stage4.mjs",
    "fonts:build": "node scripts/build-font-catalog.mjs",
    "templates:thumbs": "node scripts/build-template-thumbs.mjs",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@huggingface/transformers": "^4.3.2",
    "fabric": "^7.4.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.79.0",
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.9.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "https-proxy-agent": "^7.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "private": true,
  "type": "module"
}
