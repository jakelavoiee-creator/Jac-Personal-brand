    {"id": "d01-02-tolle-already-awakening", "youtube": "nXPWkCGXN_0", "src": "sources/nXPWkCGXN_0.mp4", "vtt": "sources/nXPWkCGXN_0.en.vtt", "start": "29.93", "end": "54.14", "caption": "If this speaks to you, you're already awakening."},
    {"id": "d01-03-dispenza-live-as-if", "youtube": "6lbnrRqBjgE", "src": "sources/6lbnrRqBjgE.mp4", "vtt": "sources/6lbnrRqBjgE.en.vtt", "start": "254.33", "end": "290.02", "caption": "Live as if it's already happening."},
    {"id": "d01-04-rohn-wish-you-were-better", "youtube": "1zNx3QyQ-9M", "src": "sources/1zNx3QyQ-9M.mp4", "vtt": "sources/1zNx3QyQ-9M.en.vtt", "start": "165.05", "end": "196.30", "caption": "Don't wish it was easier. Wish you were better."},
    {"id": "d01-05-ghiyam-never-going-backwards", "youtube": "yOwhoHC1WPw", "src": "sources/yOwhoHC1WPw.mp4", "vtt": "sources/yOwhoHC1WPw.en.vtt", "start": "517.69", "end": "546.39", "caption": "You are never going backwards."},
    {"id": "d01-06-carrey-i-was-the-universe", "youtube": "uIaY0l5qV0c", "src": "sources/uIaY0l5qV0c.mp4", "vtt": "sources/uIaY0l5qV0c.en.vtt", "start": "50.13", "end": "103.14", "caption": "You are bigger than your problems."},
    {"id": "d01-07-proctor-results-are-beliefs", "youtube": "jmv6r3IJXI0", "src": "sources/jmv6r3IJXI0.mp4", "vtt": "sources/jmv6r3IJXI0.en.vtt", "start": "45.96", "end": "75.61", "caption": "Your results are the manifestation of your beliefs."},
    {"id": "d01-08-ghiyam-pray-for-certainty", "youtube": "pWVTmPO8IUY", "src": "sources/pWVTmPO8IUY.mp4", "vtt": "sources/pWVTmPO8IUY.en.vtt", "start": "414.25", "end": "444.78", "caption": "Don't pray for the problem to go away. Pray for certainty."},
    {"id": "d01-09-lipton-love-gives-growth", "youtube": "FebZ2YNhIxw", "src": "sources/FebZ2YNhIxw.mp4", "vtt": "sources/FebZ2YNhIxw.en.vtt", "start": "59.05", "end": "80.91", "caption": "Love gives you growth. Fear shuts it down."},
    {"id": "d01-10-tolle-you-are-still-there", "youtube": "a_sMdudnswM", "src": "sources/a_sMdudnswM.mp4", "vtt": "sources/a_sMdudnswM.en.vtt", "start": "191.21", "end": "209.62", "caption": "You are still there when you're not thinking."},
    {"id": "d01-11-ghiyam-meant-for-greater", "youtube": "7U3Ex3uCmO0", "src": "sources/7U3Ex3uCmO0.mp4", "vtt": "sources/7U3Ex3uCmO0.en.vtt", "start": "333.69", "end": "347.74", "caption": "You're meant to have something greater."},
    {"id": "d01-12-dispenza-become-someone-new", "youtube": "6lbnrRqBjgE", "src": "sources/6lbnrRqBjgE.mp4", "vtt": "sources/6lbnrRqBjgE.en.vtt", "start": "292.73", "end": "341.62", "caption": "To create a new reality, become someone new."},
    {"id": "d01-13-carrey-10-million-check", "youtube": "pFq9z3PlRL4", "src": "sources/pFq9z3PlRL4.mp4", "vtt": "sources/pFq9z3PlRL4.en.vtt", "start": "111.41", "end": "156.10", "caption": "Visualization works if you work hard."},
    {"id": "d01-14-ghiyam-correction-of-the-soul", "youtube": "pWVTmPO8IUY", "src": "sources/pWVTmPO8IUY.mp4", "vtt": "sources/pWVTmPO8IUY.en.vtt", "start": "100.29", "end": "124.51", "caption": "Don't believe in the darkness you're going through."},
    {"id": "d01-15-rohn-who-you-have-become", "youtube": "1zNx3QyQ-9M", "src": "sources/1zNx3QyQ-9M.mp4", "vtt": "sources/1zNx3QyQ-9M.en.vtt", "start": "107.45", "end": "116.18", "caption": "What you have, you attracted by who you've become."},
    {"id": "d01-16-tolle-something-deeper", "youtube": "a_sMdudnswM", "src": "sources/a_sMdudnswM.mp4", "vtt": "sources/a_sMdudnswM.en.vtt", "start": "61.53", "end": "82.91", "caption": "There is something deeper in you than the thinker."},
    {"id": "d01-17-ghiyam-just-the-light", "youtube": "7U3Ex3uCmO0", "src": "sources/7U3Ex3uCmO0.mp4", "vtt": "sources/7U3Ex3uCmO0.en.vtt", "start": "546.93", "end": "560.66", "caption": "There is no good, no bad. Just the light."},
