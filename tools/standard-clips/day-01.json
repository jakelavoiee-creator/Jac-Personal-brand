    {"id": "d01-02-tolle-already-awakening", "youtube": "nXPWkCGXN_0", "src": "sources/nXPWkCGXN_0.mp4", "vtt": "sources/nXPWkCGXN_0.en.vtt", "start": "29.93", "end": "54.14", "caption": "If this speaks to you, you're already awakening."},
    {"id": "d01-03-dispenza-live-as-if", "youtube": "6lbnrRqBjgE", "src": "sources/6lbnrRqBjgE.mp4", "vtt": "sources/6lbnrRqBjgE.en.vtt", "start": "254.33", "end": "290.02", "caption": "Live as if it's already happening."},
    {"id": "d01-04-film-matrix-free-your-mind", "youtube": "3Hyc6Wku3lM", "src": "sources/3Hyc6Wku3lM.mp4", "vtt": "sources/3Hyc6Wku3lM.en.vtt", "start": "2.09", "end": "34.42", "caption": "Let go of fear and doubt. Free your mind."},
    {"id": "d01-05-rohn-wish-you-were-better", "youtube": "1zNx3QyQ-9M", "src": "sources/1zNx3QyQ-9M.mp4", "vtt": "sources/1zNx3QyQ-9M.en.vtt", "start": "165.05", "end": "196.30", "caption": "Don't wish it was easier. Wish you were better."},
    {"id": "d01-06-ghiyam-never-going-backwards", "youtube": "yOwhoHC1WPw", "src": "sources/yOwhoHC1WPw.mp4", "vtt": "sources/yOwhoHC1WPw.en.vtt", "start": "517.69", "end": "546.39", "caption": "You are never going backwards."},
    {"id": "d01-07-carrey-i-was-the-universe", "youtube": "uIaY0l5qV0c", "src": "sources/uIaY0l5qV0c.mp4", "vtt": "sources/uIaY0l5qV0c.en.vtt", "start": "50.13", "end": "103.14", "caption": "You are bigger than your problems."},
    {"id": "d01-08-film-peaceful-warrior-this-moment", "youtube": "20Slj87N3Ao", "src": "sources/20Slj87N3Ao.mp4", "vtt": "sources/20Slj87N3Ao.en.vtt", "start": "312.86", "end": "355.46", "caption": "Life only ever happens in the present."},
    {"id": "d01-09-proctor-results-are-beliefs", "youtube": "jmv6r3IJXI0", "src": "sources/jmv6r3IJXI0.mp4", "vtt": "sources/jmv6r3IJXI0.en.vtt", "start": "45.96", "end": "75.61", "caption": "Your results are the manifestation of your beliefs."},
    {"id": "d01-10-ghiyam-pray-for-certainty", "youtube": "pWVTmPO8IUY", "src": "sources/pWVTmPO8IUY.mp4", "vtt": "sources/pWVTmPO8IUY.en.vtt", "start": "414.25", "end": "444.78", "caption": "Don't pray for the problem to go away. Pray for certainty."},
