    {"id": "d01-12-film-lion-king-remember-who-you-are", "youtube": "VvjQe83greI", "src": "sources/VvjQe83greI.mp4", "vtt": "sources/VvjQe83greI.en.vtt", "start": "177.59", "end": "208.62", "caption": "You are more than what you have become."},
    {"id": "d01-13-ghiyam-meant-for-greater", "youtube": "7U3Ex3uCmO0", "src": "sources/7U3Ex3uCmO0.mp4", "vtt": "sources/7U3Ex3uCmO0.en.vtt", "start": "333.69", "end": "347.74", "caption": "You're meant to have something greater."},
    {"id": "d01-14-dispenza-become-someone-new", "youtube": "6lbnrRqBjgE", "src": "sources/6lbnrRqBjgE.mp4", "vtt": "sources/6lbnrRqBjgE.en.vtt", "start": "292.73", "end": "341.62", "caption": "To create a new reality, become someone new."},
    {"id": "d01-15-carrey-10-million-check", "youtube": "pFq9z3PlRL4", "src": "sources/pFq9z3PlRL4.mp4", "vtt": "sources/pFq9z3PlRL4.en.vtt", "start": "111.41", "end": "156.10", "caption": "Visualization works if you work hard."},
    {"id": "d01-16-film-soul-looking-for-the-ocean", "youtube": "Pg7Zit2Thks", "src": "sources/Pg7Zit2Thks.mp4", "vtt": "sources/Pg7Zit2Thks.en.vtt", "start": "142.73", "end": "160.90", "caption": "What you're searching for, you're already in."},
    {"id": "d01-17-ghiyam-correction-of-the-soul", "youtube": "pWVTmPO8IUY", "src": "sources/pWVTmPO8IUY.mp4", "vtt": "sources/pWVTmPO8IUY.en.vtt", "start": "100.29", "end": "124.51", "caption": "Don't believe in the darkness you're going through."},
    {"id": "d01-18-tolle-something-deeper", "youtube": "a_sMdudnswM", "src": "sources/a_sMdudnswM.mp4", "vtt": "sources/a_sMdudnswM.en.vtt", "start": "61.53", "end": "82.91", "caption": "There is something deeper in you than the thinker."},
    {"id": "d01-19-ghiyam-just-the-light", "youtube": "7U3Ex3uCmO0", "src": "sources/7U3Ex3uCmO0.mp4", "vtt": "sources/7U3Ex3uCmO0.en.vtt", "start": "546.93", "end": "560.66", "caption": "There is no good, no bad. Just the light."},
